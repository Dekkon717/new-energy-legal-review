{
  "name": "new-energy-legal-review",
  "version": "0.1.0",
  "private": true,
  "description": "面向新能源业务的本地合同审查辅助工具，支持桌面运行与浏览器端解析。",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win nsis portable",
    "desktop:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "mammoth": "1.9.1",
    "next": "16.2.6",
    "pdfjs-dist": "5.4.149",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vinext": "1.0.0-beta.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "chatgpt.site.wudongbird.newenergy.legalreview",
    "productName": "新能源合同审查助手",
    "asar": true,
    "electronDownload": {
      "cache": "work/electron-cache"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "新能源合同审查助手-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "新能源合同审查助手-${version}-便携版.${ext}"
    }
  }
}
